<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AssemblyName>HardenedRaids</AssemblyName>
    <RootNamespace>HardenedRaids</RootNamespace>
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Références officielles RimWorld 1.7.5000 (pas de redistribution) -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5000-unstable">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Harmony : fourni à l'exécution par le mod Harmony -->
    <PackageReference Include="Lib.Harmony" Version="2.3.6">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Vehicle Framework (optionnel à l'exécution : utilisé uniquement si le mod est actif) -->
  <PropertyGroup>
    <VFDir Condition="'$(VFDir)' == ''">$(HOME)/.local/share/Steam/steamapps/workshop/content/294100/3014915404/1.6/Assemblies</VFDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Vehicles">
      <HintPath>$(VFDir)/Vehicles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(VFDir)/SmashTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
